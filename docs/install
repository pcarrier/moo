#!/bin/sh
set -eu

repo="pcarrier/moo"
bin_dir="${BIN_DIR:-$HOME/.local/bin}"

uname_s="$(uname -s)"
uname_m="$(uname -m)"
case "$uname_s:$uname_m" in
  Linux:x86_64|Linux:amd64) target="x86_64-unknown-linux-gnu" ;;
  Darwin:x86_64|Darwin:amd64) target="x86_64-apple-darwin" ;;
  Darwin:arm64|Darwin:aarch64) target="aarch64-apple-darwin" ;;
  *) echo "unsupported platform: $uname_s $uname_m" >&2; exit 1 ;;
esac

api="https://api.github.com/repos/$repo/releases/latest"
release="$(curl -fsSL -H "Accept: application/vnd.github+json" "$api")"
latest_tag="$(printf '%s\n' "$release" | sed -n 's/.*"tag_name": "\([^"]*\)".*/\1/p' | head -n 1)"
latest_version="$(printf '%s\n' "$latest_tag" | sed 's/^[^0-9]*//')"
if [ -z "$latest_version" ]; then
  echo "could not determine latest release version" >&2
  exit 1
fi

installed="$bin_dir/moo"
if [ -x "$installed" ]; then
  installed_output="$("$installed" --version 2>/dev/null || true)"
  installed_version="$(printf '%s\n' "$installed_output" | sed -n '1s/^[^0-9]*//p')"
  if [ "$installed_version" = "$latest_version" ]; then
    echo "moo $latest_version is already installed at $installed"
    exit 0
  fi
fi

asset_url="$(printf '%s\n' "$release" | sed -n 's/.*"browser_download_url": "\([^"]*moo-[^"]*\.tar\.gz\)".*/\1/p' | grep -F -- "-$target.tar.gz" | head -n 1)"
if [ -z "$asset_url" ]; then
  echo "could not find release asset for $target" >&2
  exit 1
fi

mkdir -p "$bin_dir"
tmp_dir="$(mktemp -d)"
cleanup() { rm -rf "$tmp_dir"; }
trap cleanup EXIT INT TERM

curl -fL --progress-bar "$asset_url" -o "$tmp_dir/moo.tar.gz"
tar -xzf "$tmp_dir/moo.tar.gz" -C "$tmp_dir"
moo_bin="$(find "$tmp_dir" -type f -name moo | head -n 1)"
if [ -z "$moo_bin" ]; then
  echo "release archive did not contain moo" >&2
  exit 1
fi
install -m 755 "$moo_bin" "$bin_dir/moo"
if [ "$uname_s" = "Darwin" ] && command -v codesign >/dev/null 2>&1; then
  codesign -s - "$bin_dir/moo" 2>/dev/null || true
fi
echo "installed moo to $bin_dir/moo"
"$bin_dir/moo" --version >/dev/null 2>&1 || echo "installed binary did not report a version; try: $bin_dir/moo serve" >&2
case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *) echo "add $bin_dir to PATH, then run: moo serve" ;;
esac
