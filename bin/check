#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

cargo check
bun install --cwd shared
bun --cwd shared typecheck --pretty false
bun install --cwd web
bun --cwd web typecheck --pretty false
bun --cwd web typecheck:test --pretty false
bun --cwd web test
bun install --cwd harness
bun --cwd harness typecheck --pretty false
bun --cwd harness test
