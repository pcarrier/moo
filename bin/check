#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

bun install --cwd shared --frozen-lockfile --no-progress
bun install --cwd web --frozen-lockfile --no-progress
bun install --cwd harness --frozen-lockfile --no-progress

cargo fmt --all -- --check
cargo clippy --workspace --all-targets --all-features --locked --no-deps -- -D warnings
cargo test --workspace --locked
bun --cwd shared typecheck --pretty false
bun --cwd web typecheck --pretty false
bun --cwd web typecheck:test --pretty false
bun --cwd web test
bun --cwd harness typecheck --pretty false
bun --cwd harness test
